# ------------------------------------------------------------------
# Ponto de Vista Editora — variáveis de ambiente
# Copia este ficheiro para `.env` e preenche os valores.
# ------------------------------------------------------------------

# URL pública do site (usada em SEO, sitemap, emails, links absolutos).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------
# Supabase (novo backend — Auth + base de dados)
# Supabase Studio › Project Settings › API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA — só no servidor. Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Email transacional (Resend) — https://resend.com
# 1) Verifica o domínio do cliente: Resend › Domains › Add Domain e copia os
#    registos DNS (SPF/DKIM) para o registrar (Namecheap › Advanced DNS).
# 2) Cria uma API key: Resend › API Keys › Create.
# O remetente (EMAIL_FROM) TEM de ser um endereço @ do domínio verificado.
# ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Ponto de Vista Editora <geral@edpontodevista.com>"
# Caixa que recebe os avisos de novos pedidos (pode ser um Gmail, p.ex.).
EMAIL_NOTIFICATIONS_TO=geral@edpontodevista.com

# ------------------------------------------------------------------
# Integrações futuras (deixar vazias por agora)
# ------------------------------------------------------------------

# Anti-spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Media storage (Cloudflare R2 / S3) — F-futuro
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Pagamentos (Stripe) — F7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
