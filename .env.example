# ------------------------------------------------------------------
# Ponto de Vista Editora — variáveis de ambiente
# Copia este ficheiro para `.env` e preenche os valores.
# ------------------------------------------------------------------

# Segredo do Payload (assina tokens/auth). Gera um valor aleatório longo.
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# URL pública do site (usada em SEO, sitemap, emails, links absolutos).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------
# Supabase (novo backend — Auth + base de dados)
# Supabase Studio › Project Settings › API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA — só no servidor. Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Base de dados
# ------------------------------------------------------------------
# Se DATABASE_URI começar por "postgres", usa o adaptador PostgreSQL.
# Caso contrário (ou vazio), usa SQLite local em ./pontodevista.db
#
# PostgreSQL local (recomendado, corresponde à produção):
#   DATABASE_URI=postgres://postgres:PASSWORD@localhost:5432/pontodevista
# Neon (cloud):
#   DATABASE_URI=postgres://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# SQLite local (dev rápido, sem credenciais):
#   DATABASE_URI=file:./pontodevista.db
DATABASE_URI=file:./pontodevista.db

# ------------------------------------------------------------------
# Integrações (fases posteriores — deixar vazias por agora)
# ------------------------------------------------------------------
# Email transacional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Ponto de Vista Editora <noreply@pontodevista.example>"
EMAIL_NOTIFICATIONS_TO=

# Anti-spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Media storage (Cloudflare R2 / S3) — F-futuro
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Pagamentos (Stripe) — F7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
